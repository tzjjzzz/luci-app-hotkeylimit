#!/bin/sh
. /usr/share/libubox/jshn.sh
. /usr/share/hotkeylimit/lib.sh

hdr() { printf 'Content-Type: application/json\r\nCache-Control: no-store\r\n\r\n'; }
jerr() { json_init; json_add_string error "$1"; json_dump; }
body() { head -c "${CONTENT_LENGTH:-0}"; }
need_post() {
	[ "$REQUEST_METHOD" = POST ] || return 1
	case "$CONTENT_TYPE" in application/json*) return 0 ;; esac
	return 1
}
valid_val() {
	[ "$1" = -1 ] && return 0
	case "$1" in "" | *[!0-9]*) return 1 ;; esac
	return 0
}
out_state() {
	local ip="" up=-1 down=0
	[ -f "$CFG" ] && read -r ip up down <"$CFG"
	json_init
	json_add_string ip "$ip"
	json_add_int up "$up"
	json_add_int down "$down"
	if [ -f "$ONF" ]; then json_add_boolean on 1; else json_add_boolean on 0; fi
	json_dump
}

op=${QUERY_STRING#op=}
op=${op%%&*}

case "$op" in
devices)
	hdr
	json_init
	json_add_array devices
	[ -f /tmp/dhcp.leases ] && while read -r e mac ip host id; do
		json_add_object ""
		json_add_string ip "$ip"
		json_add_string mac "$mac"
		json_add_string name "${host:-$mac}"
		json_close_object
	done </tmp/dhcp.leases
	json_close_array
	json_dump
	;;
beat) # heartbeat + current state
	hdr
	[ -f "$ONF" ] && now >"$BEAT"
	out_state
	;;
cfg)
	hdr
	need_post || { jerr "bad request"; exit 0; }
	json_load "$(body)"
	json_get_var ip ip
	json_get_var up up
	json_get_var down down
	case "$ip" in *[!0-9.]* | "") jerr "bad ip"; exit 0 ;; esac
	valid_val "$up" && valid_val "$down" || { jerr "bad value"; exit 0; }
	echo "$ip $up $down" >"$CFG"
	if [ -f "$ONF" ]; then
		apply || { clear_all; jerr "nft: $ERR"; exit 0; }
	fi
	out_state
	;;
toggle)
	hdr
	need_post || { jerr "bad request"; exit 0; }
	if [ -f "$ONF" ]; then
		clear_all
	else
		[ -s "$CFG" ] || { jerr "no device selected"; exit 0; }
		apply || { clear_all; jerr "nft: $ERR"; exit 0; }
		now >"$BEAT"
		: >"$ONF"
	fi
	out_state
	;;
ps1)
	k=${QUERY_STRING#*key=}
	k=${k%%&*}
	case "$k" in "" | *[!A-Za-z0-9]*) k=F8 ;; esac
	h=$(printf '%s' "$HTTP_HOST" | tr -cd 'A-Za-z0-9.:_-')
	printf 'Content-Type: application/octet-stream\r\nContent-Disposition: attachment; filename="hotkey.ps1"\r\nCache-Control: no-store\r\n\r\n'
	sed -e "s|__HOST__|$h|" -e "s|__KEY__|$k|" /usr/share/hotkeylimit/hotkey.ps1.tpl
	;;
*)
	hdr
	jerr "unknown op"
	;;
esac
