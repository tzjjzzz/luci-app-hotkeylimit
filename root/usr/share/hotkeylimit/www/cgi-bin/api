#!/bin/sh
. /usr/share/libubox/jshn.sh
. /usr/share/hotkeylimit/lib.sh

hdr() { printf 'Content-Type: application/json\r\nCache-Control: no-store\r\n\r\n'; }
jerr() { json_init; json_add_string error "$1"; json_dump; }
body() { head -c "${CONTENT_LENGTH:-0}"; }
need_post() {
	[ "$REQUEST_METHOD" = POST ] || return 1
	case "$CONTENT_TYPE" in application/json*) return 0 ;; esac
	return 1
}
valid_val() {
	[ "$1" = -1 ] && return 0
	case "$1" in "" | *[!0-9]*) return 1 ;; esac
	return 0
}
# which controller sent this request: "web" (page) or "ps" (Windows script)
get_src() {
	local s
	case "$QUERY_STRING" in *src=*) s=${QUERY_STRING#*src=}; s=${s%%&*} ;; *) s=web ;; esac
	case "$s" in "" | *[!a-z0-9]*) s=web ;; esac
	echo "$s"
}
valid_ip() { case "$1" in "" | *[!0-9.]*) return 1 ;; esac; return 0; }

# "key" is this client's own hotkey for each device
out_state() {
	local ip up down rest key
	cid
	json_init
	json_add_string client "$CID"
	json_add_array list
	[ -f "$CFG" ] && while read -r ip up down rest; do
		[ -n "$ip" ] || continue
		key=$(key_for "$ip")
		json_add_object ""
		json_add_string ip "$ip"
		json_add_int up "$up"
		json_add_int down "$down"
		json_add_string key "${key:--}"
		if is_on "$ip"; then json_add_boolean on 1; else json_add_boolean on 0; fi
		json_close_object
	done <"$CFG"
	json_close_array
	json_dump
}

op=${QUERY_STRING#op=}
op=${op%%&*}

case "$op" in
devices)
	hdr
	json_init
	json_add_array devices
	[ -f /tmp/dhcp.leases ] && while read -r e mac ip host id; do
		json_add_object ""
		json_add_string ip "$ip"
		json_add_string mac "$mac"
		json_add_string name "${host:-$mac}"
		json_close_object
	done </tmp/dhcp.leases
	json_close_array
	json_dump
	;;
list) # state only, does not count as heartbeat
	hdr
	out_state
	;;
beat) # heartbeat (only counts for limits this controller turned on) + state
	hdr
	cid
	[ -s "$ONF" ] && owns_any "$CID.$(get_src)" && touch_beat "$CID.$(get_src)"
	out_state
	;;
cfg) # add/update a device's limits and THIS client's hotkey for it
	hdr
	need_post || { jerr "bad request"; exit 0; }
	json_load "$(body)"
	json_get_var ip ip
	json_get_var up up
	json_get_var down down
	json_get_var key key
	key=${key:--}
	valid_ip "$ip" || { jerr "bad ip"; exit 0; }
	valid_val "$up" && valid_val "$down" || { jerr "bad value"; exit 0; }
	case "$key" in "" | *[!A-Za-z0-9-]*) jerr "bad key"; exit 0 ;; esac
	cid
	if [ "$key" != - ]; then
		dup=$(awk -v c="$CID" -v k="$key" -v ip="$ip" '$1==c && $2==k && $3!=ip {print $3; exit}' "$BIND" 2>/dev/null)
		[ -n "$dup" ] && { jerr "key already used for $dup"; exit 0; }
	fi
	{ awk -v ip="$ip" '$1!=ip' "$CFG" 2>/dev/null; echo "$ip $up $down"; } >"$CFG.t"
	mv "$CFG.t" "$CFG"
	{ awk -v c="$CID" -v ip="$ip" '!($1==c && $3==ip)' "$BIND" 2>/dev/null; [ "$key" != - ] && echo "$CID $key $ip"; } >"$BIND.t"
	mv "$BIND.t" "$BIND"
	mark_dirty
	if is_on "$ip"; then
		apply || { set_off "$ip"; apply; jerr "nft: $ERR"; exit 0; }
	fi
	out_state
	;;
del)
	hdr
	need_post || { jerr "bad request"; exit 0; }
	json_load "$(body)"
	json_get_var ip ip
	valid_ip "$ip" || { jerr "bad ip"; exit 0; }
	awk -v ip="$ip" '$1!=ip' "$CFG" >"$CFG.t" 2>/dev/null
	mv "$CFG.t" "$CFG"
	awk -v ip="$ip" '$3!=ip' "$BIND" >"$BIND.t" 2>/dev/null
	mv "$BIND.t" "$BIND"
	mark_dirty
	set_off "$ip"
	apply
	out_state
	;;
toggle)
	hdr
	need_post || { jerr "bad request"; exit 0; }
	json_load "$(body)"
	json_get_var ip ip
	valid_ip "$ip" || { jerr "bad ip"; exit 0; }
	has_cfg "$ip" || { jerr "device not configured"; exit 0; }
	if is_on "$ip"; then
		set_off "$ip"
		apply
	else
		cid
		OWNER="$CID.$(get_src)"
		set_on "$ip" "$OWNER"
		touch_beat "$OWNER"
		apply || { set_off "$ip"; apply; jerr "nft: $ERR"; exit 0; }
	fi
	out_state
	;;
on) # idempotent: turn this device's limit on (takes ownership)
	hdr
	need_post || { jerr "bad request"; exit 0; }
	json_load "$(body)"
	json_get_var ip ip
	valid_ip "$ip" || { jerr "bad ip"; exit 0; }
	has_cfg "$ip" || { jerr "device not configured"; exit 0; }
	cid
	OWNER="$CID.$(get_src)"
	set_on "$ip" "$OWNER"
	touch_beat "$OWNER"
	apply || { set_off "$ip"; apply; jerr "nft: $ERR"; exit 0; }
	out_state
	;;
off) # idempotent: turn this device's limit off
	hdr
	need_post || { jerr "bad request"; exit 0; }
	json_load "$(body)"
	json_get_var ip ip
	valid_ip "$ip" || { jerr "bad ip"; exit 0; }
	set_off "$ip"
	apply
	out_state
	;;
alloff)
	hdr
	need_post || { jerr "bad request"; exit 0; }
	clear_all
	out_state
	;;
ps1)
	h=$(printf '%s' "$HTTP_HOST" | tr -cd 'A-Za-z0-9.:_-')
	printf 'Content-Type: application/octet-stream\r\nContent-Disposition: attachment; filename="hotkey.ps1"\r\nCache-Control: no-store\r\n\r\n'
	sed -e "s|__HOST__|$h|" /usr/share/hotkeylimit/hotkey.ps1.tpl
	;;
*)
	hdr
	jerr "unknown op"
	;;
esac
