#!/bin/sh /etc/rc.common
START=99
USE_PROCD=1

start_service() {
	local enabled port timeout
	config_load hotkeylimit
	config_get_bool enabled main enabled 1
	config_get port main port 8899
	config_get timeout main timeout 20
	[ "$enabled" = 1 ] || return 0

	procd_open_instance web
	procd_set_param command /usr/sbin/uhttpd -f -h /usr/share/hotkeylimit/www -p "0.0.0.0:$port" -x /cgi-bin -n 2 -t 30
	procd_set_param respawn
	procd_close_instance

	procd_open_instance watch
	procd_set_param command /usr/share/hotkeylimit/watch.sh "$timeout"
	procd_set_param respawn
	procd_close_instance
}

stop_service() {
	nft delete table inet hklimit 2>/dev/null
	rm -f /tmp/hklimit.on
}

service_triggers() {
	procd_add_reload_trigger hotkeylimit
}
