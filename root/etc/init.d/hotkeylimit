#!/bin/sh /etc/rc.common
START=99
USE_PROCD=1

start_service() {
	local enabled port
	config_load hotkeylimit
	config_get_bool enabled main enabled 1
	config_get port main port 8899
	[ "$enabled" = 1 ] || return 0
	procd_open_instance
	procd_set_param command /usr/sbin/uhttpd -f -h /usr/share/hotkeylimit/www -p "0.0.0.0:$port" -x /cgi-bin -n 2 -t 30
	procd_set_param respawn
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger hotkeylimit
}
